@model IEnumerable<CalendarApp.Domain.Entities.Event>
@using CalendarApp.Domain.Entities
@{
    ViewData["Title"] = "Admin Events";
}

<div class="container-fluid">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    <div class="row mb-4">
            <div class="col">
                <h2>
                    <i class="bi bi-shield-lock me-2"></i>Admin Event Management
                </h2>
                <p class="text-muted">Manage all events in the system</p>
            </div>
            <div class="col-auto">
                <a asp-action="Create" class="btn btn-warning">
                    <i class="bi bi-plus-circle"></i> Create New Event
                </a>
            </div>
        </div>

    <div class="row">
        <div class="col-12">
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <h4>No Events Found</h4>
                    <p>There are no events in the system.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="bg-warning text-dark">
                            <tr>
                                <th>Title</th>
                                <th>Date & Time</th>
                                <th>Location</th>
                                <th>Owner</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var eventItem in Model)
                            {
                                <tr>
                                    <td>
                                        <div style="display: inline-block; width: 12px; height: 12px; background-color: @eventItem.Color; border-radius: 2px; margin-right: 8px;"></div>
                                        <strong>@eventItem.Title</strong>
                                        @if (!string.IsNullOrEmpty(eventItem.Description))
                                        {
                                            <br><small class="text-muted">@eventItem.Description.Substring(0, Math.Min(eventItem.Description.Length, 100))@(eventItem.Description.Length > 100 ? "..." : "")</small>
                                        }
                                    </td>
                                    <td>
                                        @if (eventItem.AllDay)
                                        {
                                            <span>@eventItem.StartTime.ToString("MMM dd yyyy") (All Day)</span>
                                        }
                                        else
                                        {
                                            <span>@eventItem.StartTime.ToString("MMM dd yyyy HH:mm") - @eventItem.EndTime.ToString("MMM dd yyyy HH:mm")</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(eventItem.Location))
                                        {
                                            @eventItem.Location
                                        }
                                        else
                                        {
                                            <span class="text-muted">No location</span>
                                        }
                                    </td>
                                    <td>
                                        <strong>@eventItem.Owner?.UserName</strong>
                                        <br>
                                        <small class="text-muted">@eventItem.Owner?.Email</small>
                                    </td>

                                    <td>
                                        <a asp-action="Details" asp-route-id="@eventItem.Id" 
                                           class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@eventItem.Id" method="post" 
                                              onsubmit="return confirm('Are you sure you want to delete this event?');" 
                                              style="display: inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>