@model CalendarApp.Domain.Entities.Event
@using CalendarApp.Domain.Entities
@using System.Security.Claims
@{
    var users = (Dictionary<int, User>)ViewBag.Users;
    var isAdmin = (bool)(ViewBag.IsAdminContext ?? false);
    var returnView = (string?)ViewBag.ReturnView ?? "list";
    var returnDate = ((DateTime?)ViewBag.ReturnDate)?.ToString("yyyy-MM-dd");
    var cardClass = isAdmin ? "border-warning" : "border-primary";
    var headerClass = isAdmin ? "bg-warning text-dark" : "bg-primary text-white";
}

<div class="container-fluid">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if ((bool)(ViewBag.OccurrenceMissing ?? false))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            This date is not part of the series (deleted occurrence or outside the repeat range). Showing the series details instead.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card @cardClass">
                <div class="card-header @headerClass">
                    <h3 class="mb-0">
                        @Model.Title
                        @if (isAdmin)
                        {
                            <span class="badge bg-dark ms-1">Admin</span>
                        }
                    </h3>
                    <div class="mt-2">
                        <span class="badge bg-secondary">@Model.Status</span>
                    </div>
                </div>
                <div class="card-body">

                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>@(Model.AllDay ? "Start Date:" : "Start Time:")</strong></div>
                        <div class="col-sm-9">@(Model.AllDay ? Model.StartTime.ToString("D") : Model.StartTime.ToString("f"))</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>@(Model.AllDay ? "End Date:" : "End Time:")</strong></div>
                        <div class="col-sm-9">@(Model.AllDay ? Model.EndTime.ToString("D") : Model.EndTime.ToString("f"))</div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Location:</strong></div>
                            <div class="col-sm-9">@Model.Location</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Description:</strong></div>
                            <div class="col-sm-9"><span style="white-space: pre-line;">@Model.Description</span></div>
                        </div>
                    }

                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>All Day:</strong></div>
                        <div class="col-sm-9">
                            <span class="badge bg-@(Model.AllDay ? "success" : "info")">
                                @(Model.AllDay ? "Yes" : "No")
                            </span>
                        </div>
                    </div>

                    @if (Model.IsRecurring && !string.IsNullOrEmpty(Model.RecurrenceRule))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Repeat:</strong></div>
                            <div class="col-sm-9">
                                @(ViewBag.RecurrenceDescription as string ?? "Custom")
                            </div>
                        </div>
                    }

                    @if (Model.ReminderTime.HasValue)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Reminder:</strong></div>
                            <div class="col-sm-9">@Model.ReminderTime.Value.ToString("f")</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Color))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Color:</strong></div>
                            <div class="col-sm-9">
                                <div style="display: inline-block; width: 20px; height: 20px; background-color: @Model.Color; border: 1px solid #ccc; border-radius: 3px; vertical-align: middle;"></div>
                                <span class="ms-2">@Model.Color</span>
                            </div>
                        </div>
                    }

                    @if (isAdmin)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Owner:</strong></div>
                            <div class="col-sm-9">
                                <strong>@users.GetValueOrDefault(Model.OwnerId)?.UserName</strong>
                                <br>
                                <small class="text-muted">@users.GetValueOrDefault(Model.OwnerId)?.Email</small>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Event ID:</strong></div>
                            <div class="col-sm-9">@Model.Id</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Created:</strong></div>
                            <div class="col-sm-9">@Model.CreatedAt.ToString("f")</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Updated:</strong></div>
                            <div class="col-sm-9">@Model.UpdatedAt.ToString("f")</div>
                        </div>
                    }
                    else
                    {
                        var currentUserId = int.Parse(User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier) ?? "0");
                        var isAttendee = Model.EventAttendees?.Any(a => a.UserId == currentUserId) ?? false;

                        @if (isAttendee)
                        {
                            <div class="row mb-3">
                                <div class="col-sm-3"><strong>Owner:</strong></div>
                                <div class="col-sm-9">
                                    @if (Model.OwnerId == currentUserId)
                                    {
                                        <text>You are the owner</text>
                                    }
                                    else
                                    {
                                        <text>
                                            <strong>@users.GetValueOrDefault(Model.OwnerId)?.UserName</strong>
                                            <br>
                                            <small class="text-muted">@users.GetValueOrDefault(Model.OwnerId)?.Email</small>
                                        </text>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card @cardClass">
                <div class="card-header @headerClass">
                    <h5 class="mb-0">
                        Attendees (@(Model.EventAttendees?.Count(a => a.Role != AttendeeRole.Owner) ?? 0))
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.EventAttendees?.Any(a => a.Role != AttendeeRole.Owner) == true)
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var attendee in Model.EventAttendees.Where(a => a.Role != AttendeeRole.Owner))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@users.GetValueOrDefault(attendee.UserId)?.UserName</strong>
                                        <br>
                                        <small class="text-muted">@users.GetValueOrDefault(attendee.UserId)?.Email</small>
                                    </div>
                                    <div>
                                        <span class="badge bg-@(attendee.Status == AttendeeStatus.Accepted ? "success" : 
                                                         attendee.Status == AttendeeStatus.Declined ? "danger" : 
                                                         attendee.Status == AttendeeStatus.Tentative ? "warning" : "secondary")">
                                            @attendee.Status
                                        </span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No attendees</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col">
            <div class="card @(isAdmin ? "border-danger" : cardClass)">
                <div class="card-header @(isAdmin ? "bg-danger text-white" : headerClass)">
                    <h5 class="mb-0">@(isAdmin ? "Admin Actions" : "Actions")</h5>
                </div>
                <div class="card-body">
                    @if (isAdmin)
                    {
                        <a asp-area="Admin" asp-controller="Event" asp-action="Select" asp-route-ownerId="@Model.OwnerId" class="btn btn-secondary me-2">
                            <i class="bi bi-arrow-left"></i> Go Back
                        </a>
                    }
                    else if ((string?)ViewBag.ReturnView == "notifications")
                    {
                        <a href="@Url.Action("Index", "Notifications")" class="btn btn-secondary me-2">
                            <i class="bi bi-arrow-left me-1"></i>Back to Notifications
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "Events", new { view = returnView, date = returnDate })" class="btn btn-secondary me-2">
                            <i class="bi bi-arrow-left me-1"></i>Back to Events
                        </a>
                    }

                    @{
                        var editArea = isAdmin ? "Admin" : "";
                        var editController = isAdmin ? "Event" : "Events";
                    }

                    @if (Model.IsRecurring && (bool)(ViewBag.IsOccurrence ?? false))
                    {
                        <div class="btn-group me-2">
                            <button type="button" class="btn @(isAdmin ? "btn-warning" : "btn-primary") dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-pencil me-1"></i>Edit Event
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-area="@editArea" asp-controller="@editController" asp-action="Edit" asp-route-id="@Model.Id"
                                       asp-route-occurrenceDate="@Model.StartTime.ToString("yyyy-MM-dd")" asp-route-scope="this">Edit only this occurrence</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="@editArea" asp-controller="@editController" asp-action="Edit" asp-route-id="@Model.Id"
                                       asp-route-occurrenceDate="@Model.StartTime.ToString("yyyy-MM-dd")" asp-route-scope="all">Edit all occurrences</a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-area="@editArea" asp-controller="@editController" asp-action="Edit" asp-route-id="@Model.Id"
                           class="btn @(isAdmin ? "btn-warning" : "btn-primary") me-2">
                            <i class="bi bi-pencil me-1"></i>Edit Event
                        </a>
                    }

                    @if (!isAdmin && (bool)(ViewBag.CanDecline ?? false))
                    {
                        <form asp-area="" asp-controller="Events" asp-action="Decline" asp-route-id="@Model.Id" asp-route-returnView="@returnView"
                              asp-route-returnDate="@returnDate" method="post" class="d-inline"
                              onsubmit="return confirm('Decline this event? This cannot be undone.');">
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="bi bi-x-circle me-1"></i>Decline
                            </button>
                        </form>
                    }

                    @if (!isAdmin && (bool)(ViewBag.IsDeclined ?? false))
                    {
                        <span class="text-danger ms-2"><i class="bi bi-x-circle-fill"></i> You declined this event</span>
                    }

                    @if (isAdmin)
                    {
                        <form asp-area="Admin" asp-controller="Event" asp-action="Delete" asp-route-id="@Model.Id" asp-route-ownerId="@Model.OwnerId" method="post"
                              onsubmit="return confirm('Are you sure you want to delete this event? This action cannot be undone');"
                              style="display: inline;">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Delete Event
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
