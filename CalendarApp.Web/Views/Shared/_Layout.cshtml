<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CalendarApp.Web</title>
    <script type="importmap"></script>
    <script>
        // Apply saved theme and sidebar state before first paint (dark + open = default).
        // ?theme=light|dark in the URL overrides the theme without saving.
        (function () {
            var theme = 'dark';
            try { theme = localStorage.getItem('cw-theme') || 'dark'; } catch (e) { }
            try {
                var q = new URLSearchParams(window.location.search).get('theme');
                if (q === 'light' || q === 'dark') theme = q;
            } catch (e) { }
            document.documentElement.setAttribute('data-bs-theme', theme);

            var sidebar = 'open';
            try { sidebar = localStorage.getItem('cw-sidebar') || 'open'; } catch (e) { }
            document.documentElement.setAttribute('data-sidebar', sidebar === 'folded' ? 'folded' : 'open');
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CalendarApp.Web.styles.css" asp-append-version="true" />
</head>
<body>
@{
    var standalone = ViewData["Standalone"] as bool? ?? false;
}

@if (standalone)
{
    <main role="main" class="auth-page">
        @RenderBody()
    </main>
}
else
{
    <button type="button" class="mobile-menu-btn" id="sidebarMobileBtn" aria-label="Open menu">
        <i class="bi bi-list"></i>
    </button>

    <div class="app-shell">
        <partial name="_Sidebar" />
        <main role="main" class="app-main">
            <div class="container">
                @RenderBody()
            </div>
        </main>
    </div>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Dark/light theme toggle
        (function () {
            function applyThemeIcon() {
                var icon = document.getElementById('themeIcon');
                if (!icon) return;
                var dark = document.documentElement.getAttribute('data-bs-theme') !== 'light';
                icon.className = dark ? 'bi bi-sun' : 'bi bi-moon-stars';
            }
            applyThemeIcon();
            var toggle = document.getElementById('themeToggle');
            if (toggle) toggle.addEventListener('click', function () {
                var next = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-bs-theme', next);
                try { localStorage.setItem('cw-theme', next); } catch (e) { }
                applyThemeIcon();
            });
        })();

        // Sidebar fold (desktop) / drawer (mobile)
        (function () {
            function applyFoldIcon() {
                var icon = document.getElementById('sidebarFoldIcon');
                if (!icon) return;
                var folded = document.documentElement.getAttribute('data-sidebar') === 'folded';
                icon.className = folded ? 'bi bi-chevron-right' : 'bi bi-chevron-left';
            }
            applyFoldIcon();

            var fold = document.getElementById('sidebarFold');
            if (fold) fold.addEventListener('click', function () {
                var next = document.documentElement.getAttribute('data-sidebar') === 'folded' ? 'open' : 'folded';
                document.documentElement.setAttribute('data-sidebar', next);
                try { localStorage.setItem('cw-sidebar', next); } catch (e) { }
                applyFoldIcon();
            });

            var mobileBtn = document.getElementById('sidebarMobileBtn');
            var backdrop = document.getElementById('sidebarBackdrop');
            function closeMobile() { document.documentElement.removeAttribute('data-sidebar-mobile'); }
            if (mobileBtn) mobileBtn.addEventListener('click', function () {
                document.documentElement.setAttribute('data-sidebar-mobile', 'open');
            });
            if (backdrop) backdrop.addEventListener('click', closeMobile);
        })();
    </script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            $(document).ready(function() {
                updateNotificationCount();
                setInterval(updateNotificationCount, 30000);
            });

            function updateNotificationCount() {
                $.get('/Notifications/GetUnreadCount', function(data) {
                    var badge = document.getElementById('sidebarUnread');
                    if (!badge) return;
                    var count = (data && data.unreadCount) || 0;
                    if (count > 0) {
                        badge.textContent = count > 99 ? '99+' : count;
                        badge.classList.remove('d-none');
                    } else {
                        badge.classList.add('d-none');
                    }
                });
            }
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
