<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CalendarApp.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CalendarApp.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Calendar Web App</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                     <!-- Center: Calendar View Toggle Buttons - Always visible for consistent header -->
                     <ul class="navbar-nav mx-auto">
                         @{
                             var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                             var currentView = currentController == "Events" 
                                 ? ViewContext.HttpContext.Request.Query["view"].ToString()
                                 : "list";
                             if (string.IsNullOrEmpty(currentView)) currentView = "list";
                         }
                         <li class="nav-item">
                             <a class="nav-link @(currentView == "list" ? "active" : "")" href="/Events/Index?view=list">
                                 List
                             </a>
                         </li>
                         <li class="nav-item">
                             <a class="nav-link @(currentView == "monthly" ? "active" : "")" href="/Events/Index?view=monthly">
                                 Month
                             </a>
                         </li>
                     </ul>
                     
                     <!-- Right: User Actions -->
                     <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="UserManagement" asp-action="Index">
                                        <i class="bi bi-people"></i> User Management
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "Notifications", new { area = User.IsInRole("Admin") ? "Admin" : "" })">
                                    <i class="bi bi-bell"></i> Notifications
                                </a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link text-dark">Hello, @User.Identity.Name!</span>
                            </li>
                            <li class="nav-item">
                                <form class="form-inline" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - CalendarApp.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            $(document).ready(function() {
                // Load notification count when page loads
                updateNotificationCount();
                
                // Refresh notification count every 30 seconds
                setInterval(updateNotificationCount, 30000);
            });
            
            function updateNotificationCount() {
                // Determine correct URL based on user role
                const isAdmin = @(User.IsInRole("Admin") ? "true" : "false");
                const url = isAdmin ? '/Admin/Notifications/GetUnreadCount' : '/Notifications/GetUnreadCount';
                
                // Get unread notification count
                $.get(url, function(data) {
                    // No longer updating badge since it was removed
                });
            }
        </script>
    }
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
