<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CalendarApp.Web</title>
    <script type="importmap"></script>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-authenticated="@(User.Identity?.IsAuthenticated == true ? "true" : "false")">
@{
    var standalone = ViewData["Standalone"] as bool? ?? false;
}

@if (standalone)
{
    <main role="main" class="auth-page">
        @RenderBody()
    </main>
}
else
{
    <button type="button" class="mobile-menu-btn" id="sidebarMobileBtn" aria-label="Open menu">
        <i class="bi bi-list"></i>
    </button>

    <div class="app-shell">
        <partial name="_Sidebar" />
        <main role="main" class="app-main">
            <div class="container">
                @RenderBody()
            </div>
        </main>
    </div>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
