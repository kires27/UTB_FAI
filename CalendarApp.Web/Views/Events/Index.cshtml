@model MonthlyCalendarViewModel
@using CalendarApp.Domain.Entities
@using CalendarApp.Application.Models
@{
    ViewData["Title"] = "Events";
    var currentView = Model?.CurrentView ?? "list";
    // Anchor date of the current view: displayed month for monthly, grid start for daily/weekly.
    // Carried to Create so the form can send the user back to the view they came from.
    var anchorDate = (currentView == "monthly" ? Model?.DisplayMonth : Model?.CurrentDate) ?? DateTime.Now;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h2>Events</h2>
        </div>
        <div class="col-auto">
            <a asp-action="Create" asp-route-view="@currentView" asp-route-returnDate="@anchorDate.ToString("yyyy-MM-dd")" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create New Event
            </a>
        </div>
    </div>

    @if (currentView == "monthly")
    {
        if (Model != null && Model.Days.Any())
        {
            <partial name="_MonthlyCalendar" model="Model" />
        }
        else
        {
            <div class="alert alert-info">
                <h4>No Events Found</h4>
                <p>You don't have any events scheduled.</p>
            </div>
        }
    }
    else if (currentView == "daily" || currentView == "weekly")
    {
        if (Model != null && Model.Days.Any())
        {
            <partial name="_TimeGrid" model="Model" />
        }
        else
        {
            <div class="alert alert-info">
                <h4>No Events Found</h4>
                <p>You don't have any events scheduled.</p>
            </div>
        }
    }
    else
    {
		var userEvents = ViewBag.UserEvents as List<Event> ?? new List<Event>();
        
        <partial name="_ListCalendar" model="userEvents" />
    }
</div>
