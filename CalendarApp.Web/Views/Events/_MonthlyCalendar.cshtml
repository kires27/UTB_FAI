@model MonthlyCalendarViewModel
@using CalendarApp.Application.Models
@using CalendarApp.Domain.Entities
@{
    var currentUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");
    
    string GetEventActionUrl(Event evt) {
        // Recurring series: link carries the occurrence date so Details resolves that instance
        var occurrenceDate = evt.IsRecurring ? evt.StartTime.ToString("yyyy-MM-dd") : null;
        // Carry the monthly view and its month so Back returns here
        return Url.Action("Details", "Events", new { id = evt.Id, occurrenceDate = occurrenceDate, returnView = "monthly", returnDate = Model.DisplayMonth.ToString("yyyy-MM-dd") })!;
    }
}

<div class="monthly-calendar">
    <!-- Calendar Header -->
    <div class="calendar-header d-flex justify-content-between align-items-center mb-3">
        <a href="/Events/Index?view=monthly&year=@(Model.DisplayMonth.AddMonths(-1).Year)&month=@(Model.DisplayMonth.AddMonths(-1).Month)" class="btn btn-outline-secondary">
            <i class="bi bi-chevron-left"></i> Previous
        </a>
        
        <h4 class="mb-0">@Model.DisplayMonth.ToString("MMMM yyyy")</h4>
        
        <a href="/Events/Index?view=monthly&year=@(Model.DisplayMonth.AddMonths(1).Year)&month=@(Model.DisplayMonth.AddMonths(1).Month)" class="btn btn-outline-secondary">
            Next <i class="bi bi-chevron-right"></i>
        </a>
    </div>

    <!-- Calendar Grid -->
    <div class="calendar-grid">
        <!-- Weekday Headers -->
        <div class="calendar-weekdays">
            <div class="calendar-weekday">Mon</div>
            <div class="calendar-weekday">Tue</div>
            <div class="calendar-weekday">Wed</div>
            <div class="calendar-weekday">Thu</div>
            <div class="calendar-weekday">Fri</div>
            <div class="calendar-weekday">Sat</div>
            <div class="calendar-weekday">Sun</div>
        </div>

        <!-- Calendar Days -->
        <div class="calendar-days">
            @for (int i = 0; i < Model.Days.Count; i++)
            {
                var day = Model.Days[i];
                <div class="calendar-day @(day.IsCurrentMonth ? "current-month" : "other-month") @(day.IsToday ? "today" : "")"
                     data-date="@day.Date.ToString("yyyy-MM-dd")">
                    <div class="day-number">@day.Date.Day</div>
                    
                    @if (day.Events.Any())
                    {
                        <div class="day-events">
                            @foreach (var evt in day.Events)
                            {
                                <div class="event-item clickable" 
                                     data-event-id="@evt.Id"
                                     style="background-color: @(evt.Color ?? "#3788d8");"
                                     title="Click to view: @evt.Title - @(evt.AllDay ? "All day" : evt.StartTime.ToString("HH:mm"))">
                                    <a href="@GetEventActionUrl(evt)" class="event-link">
                                        @if (evt.AllDay)
                                        {
                                            <span class="event-time-all-day">@evt.Title @if (evt.IsRecurring) {<i class="bi bi-arrow-repeat" title="Recurring"></i>}</span>
                                        }
                                        else
                                        {
                                            <span class="event-time">@evt.StartTime.ToString("HH:mm")</span>
                                            <span class="event-title">@evt.Title @if (evt.IsRecurring) {<i class="bi bi-arrow-repeat" title="Recurring"></i>}</span>
                                        }
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<script src="~/js/calendar-monthly.js" asp-append-version="true"></script>