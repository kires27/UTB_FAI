@model CalendarApp.Domain.Entities.Event
@using CalendarApp.Domain.Entities
@{ var users = (Dictionary<int, User>)ViewBag.Users; }
@using System.Security.Claims
@{
    ViewData["Title"] = "Event Details";
}

<div class="container-fluid">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if ((bool)(ViewBag.OccurrenceMissing ?? false))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            This date is not part of the series (deleted occurrence or outside the repeat range). Showing the series details instead.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-calendar-event me-2"></i>@Model.Title
                    </h3>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="mb-0 mt-2 text-white-50">@Model.Description</p>
                    }
                    <div class="mt-2">
                        <span class="badge bg-secondary">@Model.Status</span>
                    </div>
                </div>
                <div class="card-body">

                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Start Time:</strong></div>
                        <div class="col-sm-9">@Model.StartTime.ToString("f")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>End Time:</strong></div>
                        <div class="col-sm-9">@Model.EndTime.ToString("f")</div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Location:</strong></div>
                            <div class="col-sm-9">@Model.Location</div>
                        </div>
                    }

                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>All Day:</strong></div>
                        <div class="col-sm-9">
                            <span class="badge bg-@(Model.AllDay ? "success" : "info")">
                                @(Model.AllDay ? "Yes" : "No")
                            </span>
                        </div>
                    </div>

                    @if (Model.IsRecurring && !string.IsNullOrEmpty(Model.RecurrenceRule))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Repeat:</strong></div>
                            <div class="col-sm-9">
                                @(CalendarApp.Application.Helpers.RecurrenceExpander.Describe(Model) ?? "Custom")
                            </div>
                        </div>
                    }

                    @if (Model.ReminderTime.HasValue)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Reminder:</strong></div>
                            <div class="col-sm-9">@Model.ReminderTime.Value.ToString("f")</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Color))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Color:</strong></div>
                            <div class="col-sm-9">
                                <div style="display: inline-block; width: 20px; height: 20px; background-color: @Model.Color; border: 1px solid #ccc; border-radius: 3px; vertical-align: middle;"></div>
                                <span class="ms-2">@Model.Color</span>
                            </div>
                        </div>
                    }

                    @{
                        var currentUserId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "0");
                        var isAttendee = Model.EventAttendees?.Any(a => a.UserId == currentUserId) ?? false;
                    }

                    @if (isAttendee)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Owner:</strong></div>
                            <div class="col-sm-9">
                                @if (Model.OwnerId == currentUserId)
                                {
                                    <text>You are the owner</text>
                                }
                                else
                                {
                                    <text>
                                        <strong>@users.GetValueOrDefault(Model.OwnerId)?.UserName</strong>
                                        <br>
                                        <small class="text-muted">@users.GetValueOrDefault(Model.OwnerId)?.Email</small>
                                    </text>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-people me-2"></i>Attendees (@(Model.EventAttendees?.Count(a => a.Role != AttendeeRole.Owner) ?? 0))
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.EventAttendees?.Any(a => a.Role != AttendeeRole.Owner) == true)
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var attendee in Model.EventAttendees.Where(a => a.Role != AttendeeRole.Owner))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@users.GetValueOrDefault(attendee.UserId)?.UserName</strong>
                                        <br>
                                        <small class="text-muted">@users.GetValueOrDefault(attendee.UserId)?.Email</small>
                                    </div>
                                    <div>
                                        <span class="badge bg-@(attendee.Status == AttendeeStatus.Accepted ? "success" : 
                                                         attendee.Status == AttendeeStatus.Declined ? "danger" : 
                                                         attendee.Status == AttendeeStatus.Tentative ? "warning" : "secondary")">
                                            @attendee.Status
                                        </span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No attendees</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-gear me-2"></i>Actions
                    </h5>
                </div>
                <div class="card-body">
                    @if ((string?)ViewBag.ReturnView == "notifications")
                    {
                        <a href="@Url.Action("Index", "Notifications")" class="btn btn-secondary me-2">
                            <i class="bi bi-arrow-left me-1"></i>Back to Notifications
                        </a>
                    }
                    else
                    {
                    <a href="@Url.Action("Index", "Events", new { view = (string?)ViewBag.ReturnView ?? "list", date = ((DateTime?)ViewBag.ReturnDate)?.ToString("yyyy-MM-dd") })" class="btn btn-secondary me-2">
                        <i class="bi bi-arrow-left me-1"></i>Back to Events
                    </a>
                    }
                    @if (User.IsInRole("Admin") || Model.OwnerId == int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!))
                    {
                        @if (Model.IsRecurring && (bool)(ViewBag.IsOccurrence ?? false))
                        {
                            <div class="btn-group me-2">
                                <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-pencil me-1"></i>Edit Event
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@Model.Id"
                                           asp-route-occurrenceDate="@Model.StartTime.ToString("yyyy-MM-dd")" asp-route-scope="this">Edit only this occurrence</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@Model.Id"
                                           asp-route-occurrenceDate="@Model.StartTime.ToString("yyyy-MM-dd")" asp-route-scope="all">Edit all occurrences</a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                                <i class="bi bi-pencil me-1"></i>Edit Event
                            </a>
                        }
                    }
                    @if ((bool)(ViewBag.CanDecline ?? false))
                    {
                        <form asp-action="Decline" asp-route-id="@Model.Id" asp-route-returnView="@((string?)ViewBag.ReturnView ?? "list")"
                              asp-route-returnDate="@((DateTime?)ViewBag.ReturnDate)?.ToString("yyyy-MM-dd")" method="post" class="d-inline"
                              onsubmit="return confirm('Decline this event? This cannot be undone.');">
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="bi bi-x-circle me-1"></i>Decline
                            </button>
                        </form>
                    }
                    @if ((bool)(ViewBag.IsDeclined ?? false))
                    {
                        <span class="text-danger ms-2"><i class="bi bi-x-circle-fill"></i> You declined this event</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>