@model List<Event>
@using CalendarApp.Domain.Entities
@{
    var currentUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        <h4>No Events Found</h4>
        <p>You don't have any events scheduled.</p>
    </div>
}
else
{
    <div class="list-calendar table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Date & Time</th>
                    <th>Location</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var eventItem in Model)
                {
                    <tr>
                        <td>
                            <div style="display: inline-block; width: 12px; height: 12px; background-color: @(eventItem.Color ?? "#3788d8"); border-radius: 2px; margin-right: 8px;"></div>
                            <strong>@eventItem.Title</strong>
                            @if (eventItem.IsRecurring)
                            {
                                <i class="bi bi-arrow-repeat text-muted" title="Recurring series occurrence"></i>
                            }
                            @if (!string.IsNullOrEmpty(eventItem.Description))
                            {
                                <br><small class="text-muted">@eventItem.Description.Substring(0, Math.Min(eventItem.Description.Length, 100))@(eventItem.Description.Length > 100 ? "..." : "")</small>
                            }
                        </td>
                        <td>
                            @if (eventItem.AllDay)
                            {
                                <span>@eventItem.StartTime.ToString("MMM dd yyyy") (All Day)</span>
                            }
                            else
                            {
                                <span>@eventItem.StartTime.ToString("MMM dd yyyy HH:mm") - @eventItem.EndTime.ToString("MMM dd yyyy HH:mm")</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(eventItem.Location))
                            {
                                @eventItem.Location
                            }
                            else
                            {
                                <span class="text-muted">No location</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("Details", "Events", new { id = eventItem.Id, occurrenceDate = eventItem.IsRecurring ? eventItem.StartTime.ToString("yyyy-MM-dd") : null })"
                               class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-eye"></i> View
                            </a>
                            @if (eventItem.OwnerId == currentUserId)
                            {
                                if (eventItem.IsRecurring)
                                {
                                    @* Recurring rows are occurrences — choose "this occurrence" or "all occurrences" *@
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-pencil"></i> Edit
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a class="dropdown-item" href="@Url.Action("Edit", "Events", new { id = eventItem.Id, occurrenceDate = eventItem.StartTime.ToString("yyyy-MM-dd"), scope = "this" })">Edit only this occurrence</a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="@Url.Action("Edit", "Events", new { id = eventItem.Id, occurrenceDate = eventItem.StartTime.ToString("yyyy-MM-dd"), scope = "all" })">Edit all occurrences</a>
                                            </li>
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <a href="@Url.Action("Edit", "Events", new { id = eventItem.Id })"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}