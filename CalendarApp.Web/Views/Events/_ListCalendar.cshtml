@model List<Event>
@using CalendarApp.Domain.Entities

@if (!Model.Any())
{
    <div class="alert alert-info">
        <h4>No Events Found</h4>
        <p>You don't have any events scheduled.</p>
    </div>
}
else
{
    <div class="list-calendar table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Date & Time</th>
                    <th>Location</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var eventItem in Model)
                {
                    // Clicking anywhere on the row opens the event details.
                    // Recurring rows carry the occurrence date so Details resolves that instance.
                    var detailsUrl = Url.Action("Details", "Events", new
                    {
                        id = eventItem.Id,
                        occurrenceDate = eventItem.IsRecurring ? eventItem.StartTime.ToString("yyyy-MM-dd") : null
                    });
                    <tr data-event-url="@detailsUrl">
                        <td>
                            <div style="display: inline-block; width: 12px; height: 12px; background-color: @(eventItem.Color ?? "#3788d8"); border-radius: 2px; margin-right: 8px;"></div>
                            <strong>
                                <a class="list-event-link" href="@detailsUrl">
                                    @eventItem.Title
                                    @if (eventItem.IsRecurring)
                                    {
                                        <i class="bi bi-arrow-repeat text-muted" title="Recurring series occurrence"></i>
                                    }
                                </a>
                            </strong>
                            @if (!string.IsNullOrEmpty(eventItem.Description))
                            {
                                <br><small class="text-muted">@eventItem.Description.Substring(0, Math.Min(eventItem.Description.Length, 100))@(eventItem.Description.Length > 100 ? "..." : "")</small>
                            }
                        </td>
                        <td>
                            @if (eventItem.AllDay)
                            {
                                <span>@eventItem.StartTime.ToString("MMM dd yyyy") (All Day)</span>
                            }
                            else
                            {
                                <span>@eventItem.StartTime.ToString("MMM dd yyyy HH:mm") - @eventItem.EndTime.ToString("MMM dd yyyy HH:mm")</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(eventItem.Location))
                            {
                                @eventItem.Location
                            }
                            else
                            {
                                <span class="text-muted">No location</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Row click -> details; inner anchors already navigate on their own *@
<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.list-calendar tbody tr[data-event-url]').forEach(function (row) {
            row.addEventListener('click', function (e) {
                if (e.target.closest('a, button')) return;
                window.location.href = row.dataset.eventUrl;
            });
        });
    });
</script>
